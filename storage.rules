rules_version = '2';

// Zesto Print — Firebase Storage Security Rules (Customer App scope)

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isValidDesignFile() {
      return request.resource.size < 25 * 1024 * 1024 &&
        request.resource.contentType.matches('image/png|image/jpeg|application/pdf');
    }

    function isValidImageFile() {
      return request.resource.size < 8 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // Product photos — public read, admin write
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidImageFile();
    }

    // Customer-uploaded print designs — owner read/write, admin read
    match /designs/{userId}/{allPaths=**} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow write: if isSignedIn() && request.auth.uid == userId && isValidDesignFile();
    }

    // Profile photos — owner read/write, admin read
    match /users/{userId}/{allPaths=**} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow write: if isSignedIn() && request.auth.uid == userId && isValidImageFile();
    }
  }
}
